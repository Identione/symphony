.envrc

# Per-instance config and state created by `make init INSTANCE=<name>` and
# the generated instance Makefile. Each operator owns their own instances —
# Linear project, repo URL, dashboard port, runtime state — so nothing under
# instances/ should be shared via git. `make init` recreates the directory
# from priv/templates/ on demand.
instances/

# Local batch-init manifest read by `make init-all` (per-operator instance
# list of Linear projects / repos / ports). The committed template is
# instances.local.example.
/instances.local

# Legacy root daemon state (PID / stdout capture) from before daemon control
# moved into per-instance Makefiles. New checkouts do not create `/run/`;
# kept here so a pre-refactor checkout's residual files don't pollute
# `git status`.
/run/

# Python bytecode caches, e.g. from running the repo-local `.codex/skills`
# helper scripts (land_watch.py). The elixir/ sidecar has its own narrower
# rule; this catches __pycache__ anywhere else in the tree.
__pycache__/
*.py[cod]
